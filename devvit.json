{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "themodverdict",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Get Verdict",
        "description": "Surface decision-quality context on this user instantly",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/verdict"
      },
      {
        "label": "Get Verdict",
        "description": "Surface decision-quality context on this user instantly",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/verdict"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "themodverdict_dev"
  }
}